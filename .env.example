# ====== 选择大模型 ======
# 可选值: deepseek, openai
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ====== API Key ======
# DeepSeek API Key（去 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=你的DeepSeek密钥

# OpenAI API Key（如果选 openai 则填这个）
# OPENAI_API_KEY=sk-xxx

# ====== 服务器设置 ======
# 网页模式监听地址和端口
SERVER_HOST=localhost
SERVER_PORT=8501

# ====== 数据库设置 ======
# 可选值: sqlite（默认，无需额外安装）, mysql, postgresql
DB_TYPE=sqlite
DB_FILE=./data/databases/default.db

# 如果用 MySQL 或 PostgreSQL，取消注释并填写：
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=my_database
# DB_USER=root
# DB_PASSWORD=your_password

# ====== SAP / ARC-1 设置（可选）=====
# 填写后自动启用 SAP ABAP 工具
# SAP_URL=https://your-sap-host:443
# SAP_USER=your_sap_user
# SAP_PASSWORD=your_sap_password
# SAP_CLIENT=100
# SAP_LANGUAGE=EN

# SAP 写操作（默认关闭，生产环境慎用）
# SAP_ALLOW_WRITES=false
# SAP_ALLOW_DATA_PREVIEW=false
# SAP_ALLOW_FREE_SQL=false
